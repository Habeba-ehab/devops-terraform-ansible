version: '3.8'
services:
  app:
    image: python:3.12-slim
    container_name: notes-app
    restart: unless-stopped
    user: "1000:1000"
    working_dir: /app
    environment:
      DATABASE_URL: "postgresql://{{ db_user }}:{{ db_password }}@{{ db_private_ip }}:{{ db_port }}/{{ db_name }}"
      PORT: "{{ app_port }}"
    command: >
      sh -c "pip install flask psycopg[binary] gunicorn &&
             python -c '
from flask import Flask, jsonify, request
import psycopg, os
app = Flask(__name__)
DB_URL = os.environ[\"DATABASE_URL\"]
with psycopg.connect(DB_URL) as conn:
    with conn.cursor() as cur:
        cur.execute(\"CREATE TABLE IF NOT EXISTS notes (id SERIAL PRIMARY KEY, title TEXT NOT NULL);\")
@app.route(\"/health\")
def health():
    return jsonify(status=\"healthy\"), 200
@app.route(\"/notes\", methods=[\"GET\", \"POST\"])
def notes():
    with psycopg.connect(DB_URL) as conn:
        with conn.cursor() as cur:
            if request.method == \"POST\":
                data = request.get_json() or {}
                title = data.get(\"title\", \"Untitled\")
                cur.execute(\"INSERT INTO notes (title) VALUES (%s) RETURNING id, title;\", (title,))
                row = cur.fetchone()
                return jsonify(id=row[0], title=row[1]), 201
            cur.execute(\"SELECT id, title FROM notes;\")
            return jsonify([{\"id\": r[0], \"title\": r[1]} for r in cur.fetchall()]), 200
app.run(host=\"0.0.0.0\", port=8000)
             '"
    networks:
      - app_net
  nginx:
    image: nginx:1.25-alpine
    container_name: nginx
    restart: unless-stopped
    ports:
      - "80:80"
    volumes:
      - /opt/app/nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - app
    networks:
      - app_net
networks:
  app_net:
    name: app_net