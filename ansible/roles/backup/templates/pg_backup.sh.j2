#!/bin/bash
# Managed by Ansible - do not edit by hand
set -euo pipefail
umask 077

BACKUP_DIR="{{ backup_dir }}"
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
BACKUP_FILE="${BACKUP_DIR}/notes_${TIMESTAMP}.dump"
TMP_FILE="${BACKUP_FILE}.tmp"

trap 'rm -f "${TMP_FILE}"' ERR

docker exec {{ postgres_container_name }} pg_dump -U {{ db_user }} -d {{ db_name }} -Fc > "${TMP_FILE}"
mv "${TMP_FILE}" "${BACKUP_FILE}"

find "${BACKUP_DIR}" -maxdepth 1 -type f -name 'notes_*.dump' -mtime +{{ backup_retention_days }} -delete

echo "Backup created: ${BACKUP_FILE}"